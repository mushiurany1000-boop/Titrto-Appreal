{"sections":{"main":{"type":"page","disabled":true,"settings":{}},"custom_liquid_64VxQT":{"type":"custom-liquid","name":"Custom liquid","settings":{"custom_liquid":"<style>\n  @import url('https:\/\/fonts.googleapis.com\/css2?family=Oswald:wght@400;700&family=Open+Sans:wght@400;600&display=swap');\n\n  .wpi-custom-section {\n    \/* Replace the background URL below with your actual Shopify image link *\/\n    background: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)), url('https:\/\/cdn.shopify.com\/s\/files\/1\/0711\/9519\/7609\/files\/bgf.png?v=1786530366?format=webp&v=1530129081') no-repeat center center;\n    background-size: cover;\n    min-height: 100vh;\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n    font-family: 'Open Sans', sans-serif;\n    color: #ffffff;\n    margin: 0;\n    padding: 0;\n    box-sizing: border-box;\n  }\n\n  .wpi-custom-section * {\n    box-sizing: border-box;\n  }\n\n  .wpi-main-content {\n    flex-grow: 1;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    padding: 40px 20px;\n  }\n\n  .wpi-logo-area {\n    text-align: center;\n    margin-bottom: 40px;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n  }\n\n  .wpi-logo-area svg {\n    width: 45px;\n    height: 45px;\n    fill: #C79F62;\n    margin-bottom: 10px;\n  }\n\n  .wpi-logo-area h1 {\n    font-family: 'Oswald', sans-serif;\n    font-size: 80px;\n    font-weight: 700;\n    letter-spacing: 5px;\n    margin: 0;\n    line-height: 1;\n    text-transform: uppercase;\n    color: #f4f4f4;\n    text-shadow: 2px 2px 4px rgba(0,0,0,0.8);\n  }\n\n  .wpi-logo-area p {\n    font-size: 14px;\n    letter-spacing: 6px;\n    margin: 10px 0 0 0;\n    text-transform: uppercase;\n    color: #e0e0e0;\n  }\n\n  .wpi-coming-soon-box {\n    background: rgba(0, 0, 0, 0.55);\n    border: 1px solid #C79F62;\n    padding: 50px 40px;\n    text-align: center;\n    max-width: 650px;\n    width: 100%;\n    position: relative;\n    overflow: hidden;\n  }\n\n  \/* Fixed Watermark *\/\n  .wpi-box-watermark {\n    position: absolute;\n    bottom: -30px;\n    left: 50%;\n    transform: translateX(-50%);\n    width: 180px;\n    height: 180px;\n    opacity: 0.04 !important; \/* Forces transparency to avoid solid white *\/\n    z-index: 1;\n    pointer-events: none;\n  }\n\n  \/* Force text to stay on top of the watermark *\/\n  .wpi-coming-soon-box h2,\n  .wpi-coming-soon-box p,\n  .wpi-divider {\n    position: relative;\n    z-index: 10 !important; \n  }\n\n  .wpi-coming-soon-box h2 {\n    font-family: 'Oswald', sans-serif;\n    font-size: 55px;\n    color: #C79F62;\n    margin: 0;\n    text-transform: uppercase;\n    line-height: 1.1;\n  }\n\n  .wpi-divider {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    margin: 25px 0;\n  }\n\n  .wpi-divider::before,\n  .wpi-divider::after {\n    content: '';\n    height: 1px;\n    background: #C79F62;\n    width: 60px;\n    opacity: 0.5;\n  }\n\n  .wpi-divider svg {\n    width: 20px;\n    height: 20px;\n    fill: #C79F62;\n    margin: 0 15px;\n  }\n\n  .wpi-coming-soon-box p {\n    font-size: 16px;\n    line-height: 1.6;\n    margin: 0;\n    color: #e0e0e0;\n  }\n\n  .wpi-features-footer {\n    background: rgba(0, 0, 0, 0.9);\n    padding: 30px 0;\n    border-top: 1px solid rgba(255,255,255,0.1);\n  }\n\n  .wpi-features-container {\n    max-width: 1200px;\n    margin: 0 auto;\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 20px;\n    padding: 0 20px;\n  }\n\n  .wpi-feature-item {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    position: relative;\n  }\n\n  .wpi-feature-item:not(:last-child)::after {\n    content: '';\n    position: absolute;\n    right: 0;\n    top: 10%;\n    height: 80%;\n    width: 1px;\n    background: rgba(255,255,255,0.2);\n  }\n\n  .wpi-feature-icon {\n    margin-right: 15px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .wpi-feature-icon svg {\n    width: 38px; \/* Slightly increased size for better visibility *\/\n    height: 38px;\n    fill: none;\n    stroke: #C79F62;\n    stroke-width: 1.2;\n  }\n\n  .wpi-feature-text h4 {\n    color: #ffffff;\n    font-size: 14px;\n    font-weight: 600;\n    margin: 0 0 4px 0;\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n  }\n\n  .wpi-feature-text p {\n    color: #999999;\n    font-size: 12px;\n    margin: 0;\n  }\n\n  @media screen and (max-width: 990px) {\n    .wpi-features-container {\n      grid-template-columns: repeat(2, 1fr);\n      row-gap: 30px;\n    }\n    .wpi-feature-item:nth-child(2)::after {\n      display: none;\n    }\n  }\n\n  @media screen and (max-width: 768px) {\n    .wpi-logo-area h1 {\n      font-size: 55px;\n    }\n    .wpi-coming-soon-box h2 {\n      font-size: 40px;\n    }\n    .wpi-coming-soon-box {\n      padding: 35px 20px;\n    }\n    .wpi-features-container {\n      grid-template-columns: 1fr;\n      row-gap: 25px;\n    }\n    .wpi-feature-item {\n      justify-content: flex-start;\n      padding-left: 10%;\n    }\n    .wpi-feature-item::after {\n      display: none;\n    }\n  }\n<\/style>\n\n<div class=\"wpi-custom-section\">\n  <div class=\"wpi-main-content\">\n    \n    <div class=\"wpi-logo-area\">\n      <svg viewBox=\"0 0 24 24\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\">\n        <path d=\"M12 2L12 22M12 12C9 12 5 10 5 6V4L6 4V8C6 10 8 11 11 11H13C16 11 18 10 18 8V4L19 4V6C19 10 15 12 12 12Z\" stroke=\"#C79F62\" stroke-width=\"2\" fill=\"none\"\/>\n        <path d=\"M12 2L14 6H10L12 2Z\" fill=\"#C79F62\"\/>\n        <path d=\"M6 4L7 6H5L6 4Z\" fill=\"#C79F62\"\/>\n        <path d=\"M18 4L19 6H17L18 4Z\" fill=\"#C79F62\"\/>\n      <\/svg>\n      <h1>WPI<\/h1>\n      <p>Partner Storefront<\/p>\n    <\/div>\n\n    <div class=\"wpi-coming-soon-box\">\n      <!-- Watermark Trident with explicit white color to prevent theme override -->\n      <svg class=\"wpi-box-watermark\" viewBox=\"0 0 24 24\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\">\n        <path d=\"M12 2L12 22M12 12C9 12 5 10 5 6V4L6 4V8C6 10 8 11 11 11H13C16 11 18 10 18 8V4L19 4V6C19 10 15 12 12 12Z\" stroke=\"#ffffff\" stroke-width=\"2\" fill=\"none\"\/>\n        <path d=\"M12 2L14 6H10L12 2Z\" fill=\"#ffffff\"\/>\n      <\/svg>\n\n      <h2>Coming Soon<\/h2>\n      \n      <div class=\"wpi-divider\">\n        <svg viewBox=\"0 0 24 24\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\">\n          <path d=\"M12 2L12 22M12 12C9 12 5 10 5 6V4L6 4V8C6 10 8 11 11 11H13C16 11 18 10 18 8V4L19 4V6C19 10 15 12 12 12Z\" stroke=\"#C79F62\" stroke-width=\"1.5\" fill=\"none\"\/>\n          <path d=\"M12 2L13 5H11L12 2Z\" fill=\"#C79F62\"\/>\n        <\/svg>\n      <\/div>\n\n      <p>The WPI partner storefront is currently under development.<br>Thank you for your patience.<\/p>\n    <\/div>\n  <\/div>\n\n  <div class=\"wpi-features-footer\">\n    <div class=\"wpi-features-container\">\n      \n      <div class=\"wpi-feature-item\">\n        <div class=\"wpi-feature-icon\">\n          <svg viewBox=\"0 0 24 24\" stroke-linejoin=\"round\" stroke-linecap=\"round\">\n            <path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"\/>\n            <path d=\"M12 8v8M10 10l2-2 2 2\" stroke-width=\"1\"\/>\n          <\/svg>\n        <\/div>\n        <div class=\"wpi-feature-text\">\n          <h4>Exclusive Access<\/h4>\n          <p>Dedicated for our partners<\/p>\n        <\/div>\n      <\/div>\n\n      <div class=\"wpi-feature-item\">\n        <div class=\"wpi-feature-icon\">\n          <svg viewBox=\"0 0 24 24\" stroke-linejoin=\"round\" stroke-linecap=\"round\">\n            <path d=\"M8 12a4 4 0 1 0 8 0 4 4 0 1 0-8 0\"\/>\n            <path d=\"M15 15l-3 3-3-3M12 18v-6\"\/>\n            <path d=\"M4 8h16\"\/>\n          <\/svg>\n        <\/div>\n        <div class=\"wpi-feature-text\">\n          <h4>Built Together<\/h4>\n          <p>Strong partnerships, shared success<\/p>\n        <\/div>\n      <\/div>\n\n      <div class=\"wpi-feature-item\">\n        <div class=\"wpi-feature-icon\">\n          <svg viewBox=\"0 0 24 24\" stroke-linejoin=\"round\" stroke-linecap=\"round\">\n            <rect x=\"5\" y=\"11\" width=\"14\" height=\"10\" rx=\"2\" ry=\"2\"\/>\n            <path d=\"M7 11V7a5 5 0 0 1 10 0v4\"\/>\n            <circle cx=\"12\" cy=\"16\" r=\"1\" fill=\"#C79F62\"\/>\n          <\/svg>\n        <\/div>\n        <div class=\"wpi-feature-text\">\n          <h4>Secure & Private<\/h4>\n          <p>By invitation only<\/p>\n        <\/div>\n      <\/div>\n\n      <div class=\"wpi-feature-item\">\n        <div class=\"wpi-feature-icon\">\n          <svg viewBox=\"0 0 24 24\" stroke-linejoin=\"round\" stroke-linecap=\"round\">\n            <circle cx=\"12\" cy=\"12\" r=\"10\"\/>\n            <polygon points=\"16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76\" stroke-width=\"1.5\"\/>\n          <\/svg>\n        <\/div>\n        <div class=\"wpi-feature-text\">\n          <h4>Made to Perform<\/h4>\n          <p>Premium gear for the mission<\/p>\n        <\/div>\n      <\/div>\n\n    <\/div>\n  <\/div>\n<\/div>","custom_class":""}}},"order":["main","custom_liquid_64VxQT"]}