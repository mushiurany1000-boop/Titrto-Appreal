-columns: repeat(2, 1fr);\n    gap: 16px; \n  }\n  \n  @media screen and (min-width: 750px) {\n    .luxury-features-grid {\n      grid-template-columns: repeat(4, 1fr);\n      gap: 24px;\n    }\n  }\n  \n  \/* Premium Modern Transparent Card *\/\n  .luxury-feature-card {\n    background: transparent;\n    border-radius: 12px; \n    padding: 24px 16px;\n    text-align: center;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    border: 1px solid rgba(255, 255, 255, 0.1); \/* Halka white border *\/\n    transition: all 0.5s cubic-bezier(0.165, 0.84, 0.44, 1);\n    cursor: default;\n    backdrop-filter: blur(10px); \/* Modern glassmorphism touch *\/\n  }\n  \n  \/* Hover effects: slightly lifts up, border brightens, soft glow *\/\n  .luxury-feature-card:hover {\n    transform: translateY(-5px);\n    border-color: rgba(255, 255, 255, 0.35); \n    background: rgba(255, 255, 255, 0.03); \/* Subtle fill on hover *\/\n    box-shadow: 0 10px 30px rgba(255, 255, 255, 0.05); \n  }\n  \n  .luxury-icon {\n    margin-bottom: 16px;\n    color: #ffffff; \/* White icon *\/\n    transition: transform 0.5s ease, filter 0.5s ease;\n  }\n  \n  .luxury-feature-card:hover .luxury-icon {\n    transform: scale(1.15); \n    filter: drop-shadow(0 0 8px rgba(255, 255, 255, 0.4)); \/* Premium icon glow *\/\n  }\n  \n  .luxury-icon svg {\n    width: 28px; \n    height: 28px;\n    display: block;\n  }\n  \n  .luxury-text {\n    margin: 0;\n    font-size: 12px; \n    color: #ffffff; \/* White text *\/\n    line-height: 1.5;\n    font-weight: 500;\n    letter-spacing: 1.5px; \/* Wider spacing for luxury aesthetic *\/\n    text-transform: uppercase; \n  }\n<\/style>\n\n<div class=\"luxury-features-section\">\n  <div class=\"luxury-features-wrapper\">\n    <div class=\"luxury-features-grid\">\n      \n      <!-- Item 1: Global Shipping -->\n      <div class=\"luxury-feature-card\">\n        <div class=\"luxury-icon\">\n          <svg xmlns=\"h