.m-richtext__subtitle.m-slide__subtitle.m\:text-white.h5 {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 5px 15px;
    min-width: 240px;

    font-size: 13px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #fff;

    background: linear-gradient(
        180deg,
        rgba(255,255,255,.12),
        rgba(255,255,255,.05)
    );

    border: 1px solid rgba(227,184,84,.9);
    border-radius: 999px;

    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);

    box-shadow:
        0 0 0 1px rgba(255,255,255,.08) inset,
        0 8px 24px rgba(0,0,0,.35),
        0 0 20px rgba(227,184,84,.18);

    transition: all .35s ease;
}

.m-richtext__subtitle.m-slide__subtitle.m\:text-white.h5:hover {
    transform: translateY(-2px);
    border-color: #f4c96a;

    box-shadow:
        0 0 0 1px rgba(255,255,255,.12) inset,
        0 12px 30px rgba(0,0,0,.45),
        0 0 30px rgba(244,201,106,.35);
}
.m-richtext__subtitle.m-slide__subtitle.m\:text-white.h5::before{
    content: "";
    width: 8px;
    height: 8px;
    margin-right: 10px;
    border-radius: 50%;
    background: radial-gradient(circle, #ffe7a5, #d8a62b);
    box-shadow: 0 0 10px rgba(255,215,0,.7);
}
@media (max-width: 767px) {
    .m-richtext__subtitle.m-slide__subtitle.m\:text-white.h5 {
        display: none !important;
    }
    .m-announcement-bar__content {
    padding: 1px;
}
}

