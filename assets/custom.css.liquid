/* Full Final Smooth Custom Cursor CSS */
@media (pointer: fine) {
  .custom-cursor {
    position: fixed;
    top: 0;
    left: 0;
    width: 12px;
    height: 12px;
    background-color: #f5c542; 
    border-radius: 50%;
    pointer-events: none; 
    z-index: 999999;
    will-change: transform, width, height;
    
    transition: width 0.2s ease, height 0.2s ease, background-color 0.2s ease;
  }

  
  .custom-cursor.hovered {
    width: 32px; 
    height: 32px;
    background-color: rgba(245, 197, 66, 0.57); 
  }
}

