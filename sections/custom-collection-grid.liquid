        { "type": "collection_item", "settings": { "title": "HUNTERS & FISHERMEN" } },
        { "type": "collection_item", "settings": { "title": "FUNNY TEES" } },
        { "type": "collection_item", "settings": { "title": "DOG COLLECTION" } }
      ]
    }
  ]
}
{% endschema %} {% endcomment %}










