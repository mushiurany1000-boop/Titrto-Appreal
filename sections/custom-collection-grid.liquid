    display: flex;
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* --- Border Glow Effect --- */
  .custom-grid-item:hover {
    border-color: {{ section.settings.btn_border_color }};
    box-shadow: 0 0 15px rgba(197, 164, 126, 0.3); /* Softer glowing border */
  }

  .grid-item-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }
  .grid-item-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.7s ease; 
  }

  /* --- Image Zoom Effect --- */
  .custom-grid-item:hover .grid-item-bg img {
    transform: scale(1.06); 
  }

  /* --- Left-to-Right Dark Gradient for readability --- */
  .grid-item-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.4) 55%, rgba(0,0,0,0.05) 100%);
    z-index: 2;
  }

  .grid-item-content {
    position: relative;
    z-index: 3;
    text-align: left;
    padding: 20px 25px; /* Slightly reduced padding to match shorter height */
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start; /* Left aligns content */
    justify-content: center; /* Vertically centers content */
  }

  /* Icon Container */
  .grid-item-icon {
    width: 45px;
    height: 45px;
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.3);
    padding: 5px;
    border-radius: 4px;
  }
  .grid-item-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  
  .grid-item-title {
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.title_size }}px;
    font-weight: 700;
    text-transform: uppercase;
    margin: 0 0 12px 0;
    letter-spacing: 0.5px;
    line-height: 1.2;
    text-shadow: 1px 1px 5px rgba(0,0,0,0.8);
  }

  .grid-item-btn {
    display: inline-block;
    padding: 9px 24px;
    border: 1px solid {{ section.settings.btn_border_color }};
    background-color: {{ section.settings.btn_bg_color }};
    color: {{ section.settings.btn_text_color }};
    text-decoration: none;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    border-radius: 3px;
    transition: all 0.3s ease;
  }
  
  /* --- Button Fill Effect --- */
  .custom-grid-item:hover .grid-item-btn {
    background-color: {{ section.settings.btn_border_color }};
    color: #000000; /* Dark text on hover for contrast */
    box-shadow: 0 4px 10px rgba(0,0,0,0.5);
  }

  /* Responsive Breakpoints */
  @media (max-width: 1300px) {
    .custom-grid-container {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  
  @media (max-width: 900px) {
    .custom-grid-container {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (max-width: 600px) {
    .custom-grid-container {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .custom-grid-item {
      height: 135px; /* Creates the slim banner layout for mobile */
      border-radius: 8px;
    }
    .grid-item-content {
      padding: 15px 20px;
    }
    .grid-item-title {
      font-size: calc({{ section.settings.title_size }}px * 0.85);
      margin: 0 0 8px 0;
    }
    .grid-item-btn {
      padding: 7px 18px;
      font-size: 10px;
    }
  }
