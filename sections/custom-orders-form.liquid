<style>
  /* Triton Apparel Dark Theme Custom Orders Section */
  .triton-dark-wrapper {
    background-color: #0d1117; /* Premium Dark Background */
    padding: 80px 20px;
    font-family: {{ settings.type_body_font.family | default: 'Helvetica, Arial, sans-serif' }};
    color: #ffffff;
  }

  .triton-dark-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 60px;
    align-items: flex-start;
  }

  /* Left Column: Typography & Info */
  .triton-text-col {
    padding-top: 20px;
  }

  .triton-text-col h2 {
    font-size: 42px;
    color: #ffffff; /* White Text */
    text-transform: uppercase;
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 25px;
    letter-spacing: 0.5px;
  }

  .triton-text-col p {
    font-size: 18px;
    color: #a0aec0; /* Soft Light Gray for readability */
    line-height: 1.7;
    margin-bottom: 30px;
  }

  .triton-features {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .triton-features li {
    font-size: 16px;
    color: #ffffff; /* White Text */
    margin-bottom: 15px;
    display: flex;
    align-items: center;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .triton-features li::before {
    content: '✓';
    color: #d97736; /* Triton Restrained Orange */
    font-weight: bold;
    margin-right: 12px;
    font-size: 18px;
  }

  /* Right Column: Dark Form */
  .triton-form-col {
    background: #161b22; /* Slightly lighter dark shade for form card */
    padding: 50px;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    border: 1px solid #30363d;
  }

  .triton-form-row {
    display: flex;
    gap: 20px;
    margin-bottom: 25px;
  }

  .triton-form-group {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .triton-form-group label {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #8b949e; /* Muted label color */
    font-weight: 700;
    margin-bottom: 8px;
  }

  .triton-form-group input,
  .triton-form-group select,
  .triton-form-group textarea {
    width: 100%;
    padding: 15px 0;
    border: none;
    border-bottom: 2px solid #30363d;
    background-color: transparent;
    font-size: 16px;
    color: #ffffff; /* White text input */
    transition: all 0.3s ease;
    border-radius: 0;
  }

  /* Dropdown option background fix for dark theme */
  .triton-form-group select option {
    background-color: #161b22;
    color: #ffffff;
  }

  .triton-form-group input:focus,
  .triton-form-group select:focus,
  .triton-form-group textarea:focus {
    outline: none;
    border-bottom-color: #d97736; /* Triton Restrained Orange */
    box-shadow: 0 4px 2px -2px rgba(217, 119, 54, 0.2);
  }
  
  /* Remove autofill white background styling on Webkit browsers */
  input:-webkit-autofill,
  input:-webkit-autofill:hover, 
  input:-webkit-autofill:focus, 
  textarea:-webkit-autofill,
  textarea:-webkit-autofill:hover,
  textarea:-webkit-autofill:focus,
  select:-webkit-autofill,
  select:-webkit-autofill:hover,
  select:-webkit-autofill:focus {
    -webkit-text-fill-color: white !important;
    -webkit-box-shadow: 0 0 0px 1000px transparent inset;
    transition: background-color 5000s ease-in-out 0s;
  }

  .triton-form-group textarea {
    resize: vertical;
    min-height: 100px;
  }

  .triton-submit-btn {
    background-color: #d97736; /* Triton Restrained Orange for contrast */
    color: #ffffff;
    border: none;
    padding: 18px 40px;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    border-radius: 4px;
    cursor: pointer;
    width: 100%;
    transition: background-color 0.3s ease, transform 0.2s ease;
    margin-top: 15px;
  }

  .triton-submit-btn:hover {
    background-color: #c0652a; /* Darker orange on hover */
    transform: translateY(-2px);
  }

  /* Form Success Message */
  .triton-success-msg {
    background-color: #122a1b;
    color: #3fb950;
    padding: 15px;
    border-radius: 4px;
    margin-bottom: 25px;
    font-weight: 600;
    text-align: center;
    border-left: 4px solid #3fb950;
  }

  /* Form Error Message */
  .errors {
    background-color: #3b1318;
    color: #ff7b72;
    padding: 15px;
    border-radius: 4px;
    margin-bottom: 25px;
    font-size: 14px;
    border-left: 4px solid #ff7b72;
  }
  .errors ul { margin: 0; padding-left: 20px; }

  /* Mobile Responsiveness */
  @media screen and (max-width: 991px) {
    .triton-dark-container {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .triton-text-col {
      text-align: center;
    }
    .triton-features li {
      justify-content: center;
    }
  }

  @media screen and (max-width: 768px) {
    .triton-dark-wrapper {
      padding: 50px 15px;
    }
    .triton-form-col {
      padding: 30px 20px;
    }
    .triton-form-row {
      flex-direction: column;
      gap: 25px;
    }
    .triton-text-col h2 {
      font-size: 32px;
    }
  }
</style>

<div class="triton-dark-wrapper">
  <div class="triton-dark-container">
    
    <!-- Left Column: Typography & Info -->
    <div class="triton-text-col">
      <h2>{{ section.settings.heading | default: "Bring Your Vision to the Water or the Woods" }}</h2>
      <p>{{ section.settings.description | default: "Whether you need gear for a fishing tournament, a hunting club, or a corporate outdoor event, Triton Apparel has you covered. Fill out the form with your requirements, and our team will get back to you with a custom quote." }}</p>
      
      <ul class="triton-features">
        <li>Team Uniforms</li>
        <li>Event Merchandise</li>
        <li>Organization Gear</li>
      </ul>
    </div>

    <!-- Right Column: Dark Form -->
    <div class="triton-form-col">
      {% form 'contact' %}
        {% if form.posted_successfully? %}
          <div class="triton-success-msg">
            Thank you! Your custom order inquiry has been submitted successfully. We will get back to you shortly.
          </div>
        {% endif %}

        {{ form.errors | default_errors }}

        <div class="triton-form-row">
          <div class="triton-form-group">
            <label for="CustomFirstName">First Name</label>
            <input type="text" id="CustomFirstName" name="contact[first_name]" placeholder="John" required>
          </div>
          <div class="triton-form-group">
            <label for="CustomLastName">Last Name</label>
            <input type="text" id="CustomLastName" name="contact[last_name]" placeholder="Doe" required>
          </div>
        </div>

        <div class="triton-form-row">
          <div class="triton-form-group">
            <label for="CustomEmail">Email Address</label>
            <input type="email" id="CustomEmail" name="contact[email]" placeholder="john@example.com" required>
          </div>
          <div class="triton-form-group">
            <label for="CustomPhone">Phone Number</label>
            <input type="tel" id="CustomPhone" name="contact[phone]" placeholder="(Optional)">
          </div>
        </div>

        <div class="triton-form-row">
          <div class="triton-form-group">
            <label for="CustomOrg">Organization / Team Name</label>
            <input type="text" id="CustomOrg" name="contact[organization_name]" placeholder="e.g., Singletary Rod & Gun" required>
          </div>
        </div>

        <div class="triton-form-row">
          <div class="triton-form-group">
            <label for="CustomType">Order Type</label>
            <select id="CustomType" name="contact[order_type]">
              <option value="Team Apparel">Team Apparel</option>
              <option value="Event Merchandise">Event Merchandise</option>
              <option value="Organization Gear">Organization Gear</option>
              <option value="Other">Other</option>
            </select>
          </div>
          <div class="triton-form-group">
            <label for="CustomQty">Estimated Quantity</label>
            <input type="text" id="CustomQty" name="contact[quantity]" placeholder="e.g., 50-100 items">
          </div>
        </div>

        <div class="triton-form-row" style="margin-bottom: 10px;">
          <div class="triton-form-group">
            <label for="CustomDetails">Project Details & Requirements</label>
            <textarea id="CustomDetails" name="contact[body]" placeholder="Describe your custom order needs, preferred colors, and deadline..." required></textarea>
          </div>
        </div>

        <button type="submit" class="triton-submit-btn">Submit Inquiry</button>
      {% endform %}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Dark Custom Orders Form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bring Your Vision to the Water or the Woods"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Whether you need gear for a fishing tournament, a hunting club, or a corporate outdoor event, Triton Apparel has you covered. Fill out the form with your requirements, and our team will get back to you with a custom quote."
    }
  ],
  "presets": [
    {
      "name": "Dark Custom Orders Form",
      "category": "Forms"
    }
  ]
}
{% endschema %}