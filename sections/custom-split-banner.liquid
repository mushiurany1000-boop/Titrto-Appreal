{% comment %}
  Custom Split Banner: Left Image, Right Content Area with Torn-edge details.
  Fully editable colors, paddings, sizes, and icon blocks.
{% endcomment %}

<div class="split-banner-wrapper section-{{ section.id }}">
  <div class="split-banner-container">
    
    <!-- Left Side Image -->
    <div class="split-banner-image-side">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | img_url: '1000x' }}" alt="{{ section.settings.heading | escape }}" loading="lazy">
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {% endif %}
    </div>

    <!-- Right Side Content -->
    <div class="split-banner-content-side">
      <!-- Golden Torn/Rough Border Line Effect -->
      <div class="torn-edge-divider"></div>
      
      <div class="content-side-inner">
        {% if section.settings.heading != blank %}
          <h2 class="split-banner-heading">{{ section.settings.heading }}</h2>
        {% endif %}
        
        {% if section.settings.subheading != blank %}
          <h3 class="split-banner-subheading">{{ section.settings.subheading }}</h3>
        {% endif %}
        
        {% if section.settings.description != blank %}
          <div class="split-banner-desc">
            <p>{{ section.settings.description }}</p>
          </div>
        {% endif %}

        <!-- 4-Column Icon Grid underneath description -->
        <div class="split-banner-icons-grid">
          {% for block in section.blocks %}
            <div class="split-icon-item" {{ block.shopify_attributes }}>
              <div class="split-icon-img-wrap">
                {% if block.settings.icon_image != blank %}
                  <img src="{{ block.settings.icon_image | img_url: '80x' }}" alt="{{ block.settings.icon_text }}" loading="lazy">
                {% else %}
                  <!-- Fallback mini SVG if no icon uploaded -->
                  <svg viewBox="0 0 24 24" fill="none" stroke="{{ section.settings.accent_color }}" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/></svg>
                {% endif %}
              </div>
              {% if block.settings.icon_text != blank %}
                <span class="split-icon-label">{{ block.settings.icon_text }}</span>
              {% endif %}
            </div>
          {% endfor %}
        </div>

        <!-- Request a Quote Button -->
        {% if section.settings.btn_text != blank %}
          <a href="{{ section.settings.btn_link }}" class="split-banner-btn">
            {{ section.settings.btn_text }}
          </a>
        {% endif %}
      </div>
    </div>

  </div>
</div>

{% style %}
  .section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.pad_top }}px;
    padding-bottom: {{ section.settings.pad_bottom }}px;
    padding-left: 15px;
    padding-right: 15px;
  }
  .split-banner-container {
    display: flex;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    background-color: {{ section.settings.content_bg_color }};
    border: 1px solid {{ section.settings.outer_border_color }};
    overflow: hidden;
  }
  
  /* Left Image Setup */
  .split-banner-image-side {
    flex: 0 0 45%;
    position: relative;
  }
  .split-banner-image-side img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Right Content Setup with Rough Border Line */
  .split-banner-content-side {
    flex: 0 0 55%;
    position: relative;
    display: flex;
    align-items: center;
    background-color: {{ section.settings.content_bg_color }};
  }
  
  /* Imitating the rugged/torn line asset visually using pseudo borders */
  .torn-edge-divider {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 4px;
    background: linear-gradient(to bottom, {{ section.settings.accent_color }} 0%, rgba(197,164,126,0.3) 50%, {{ section.settings.accent_color }} 100%);
    box-shadow: -2px 0px 5px rgba(0,0,0,0.5);
    z-index: 3;
  }
  
  .content-side-inner {
    padding: {{ section.settings.content_padding }}px;
    width: 100%;
  }

  /* Typography Sizing & Colors */
  .split-banner-heading {
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 500;
    text-transform: uppercase;
    margin: 0 0 8px 0;
    letter-spacing: 1.5px;
    line-height: 1.2;
  }
  .split-banner-subheading {
    color: {{ section.settings.accent_color }};
    font-size: {{ section.settings.subheading_size }}px;
    font-weight: 700;
    text-transform: uppercase;
    margin: 0 0 15px 0;
    letter-spacing: 1px;
  }
  .split-banner-desc {
    color: {{ section.settings.desc_color }};
    font-size: {{ section.settings.desc_size }}px;
    line-height: 1.5;
    margin-bottom: 30px;
    max-width: 90%;
  }
  .split-banner-desc p {
    margin: 0;
  }

  /* Icons Row */
  .split-banner-icons-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
    margin-bottom: 35px;
  }
  .split-icon-item {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .split-icon-img-wrap {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .split-icon-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .split-icon-label {
    color: {{ section.settings.icon_text_color }};
    font-size: {{ section.settings.icon_text_size }}px;
    font-weight: 700;
    text-transform: uppercase;
    line-height: 1.2;
    letter-spacing: 0.5px;
  }

  /* Premium Metallic Gradient Button */
  .split-banner-btn {
    display: inline-block;
    padding: 12px 35px;
    background: #b17e00;
    color: #ffffff;
    font-size: 13px;
    font-weight: 500;
    text-transform: uppercase;
    text-decoration: none;
    letter-spacing: 1.5px;
    border-radius: 4px;
    transition: opacity 0.3s ease;
    box-shadow: 0 4px 15px rgba(0,0,0,0.4);
  }
  .split-banner-btn:hover {
    opacity: 0.9;
  }

  /* Responsive Design Styles (Mobile Friendly) */
  @media (max-width: 991px) {
    .split-banner-heading {
      font-size: calc({{ section.settings.heading_size }}px * 0.8);
    }
    .content-side-inner {
      padding: 30px;
    }
    .split-banner-icons-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }

  @media (max-width: 767px) {
    .split-banner-container {
      flex-direction: column; /* Stacks image on top, text below on mobile */
    }
    .split-banner-image-side {
      flex: 0 0 auto;
      height: 250px; /* Controlled height for mobile display */
    }
    .split-banner-content-side {
      flex: 0 0 auto;
    }
    .torn-edge-divider {
      width: 100%;
      height: 4px; /* Changes divider to horizontal on mobile layouts */
      bottom: auto;
    }
    .split-banner-desc {
      max-width: 100%;
    }
    .split-banner-icons-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Split Bulk Order Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Left Side Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "BULK ORDERS & CUSTOM APPAREL"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "OUTFIT YOUR TEAM, CLUB OR BUSINESS"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "We specialize in custom designs and bulk orders for teams, clubs, events and businesses."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Label",
      "default": "REQUEST A QUOTE"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Sizing & Paddings"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 2000,
      "step": 50,
      "unit": "px",
      "label": "Max Container Width",
      "default": 1350
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 18,
      "max": 45,
      "step": 1,
      "unit": "px",
      "label": "Heading Font Size",
      "default": 32
    },
    {
      "type": "range",
      "id": "subheading_size",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Subheading Font Size",
      "default": 18
    },
    {
      "type": "range",
      "id": "desc_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Description Font Size",
      "default": 15
    },
    {
      "type": "range",
      "id": "icon_text_size",
      "min": 10,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Icon Label Font Size",
      "default": 12
    },
    {
      "type": "range",
      "id": "content_padding",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Right Area Inner Padding",
      "default": 50
    },
    {
      "type": "range",
      "id": "pad_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Section Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Section Padding Bottom",
      "default": 40
    },
    {
      "type": "header",
      "content": "Color Overrides"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "content_bg_color",
      "label": "Content Box Background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "outer_border_color",
      "label": "Outer Gold Thin Border",
      "default": "#3a2d1f"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Subhead & Accent Line Color",
      "default": "#c5a47e"
    },
    {
      "type": "color",
      "id": "desc_color",
      "label": "Description Color",
      "default": "#cccccc"
    },
    {
      "type": "color",
      "id": "icon_text_color",
      "label": "Icon Text Color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "icon_block",
      "name": "Icon Label Feature",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Golden Feature Icon"
        },
        {
          "type": "text",
          "id": "icon_text",
          "label": "Feature Text Label",
          "default": "FEATURE LABEL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Split Bulk Order Banner",
      "blocks": [
        { "type": "icon_block", "settings": { "icon_text": "NO MINIMUMS" } },
        { "type": "icon_block", "settings": { "icon_text": "LOW PRICING" } },
        { "type": "icon_block", "settings": { "icon_text": "FAST TURNAROUND" } },
        { "type": "icon_block", "settings": { "icon_text": "PREMIUM QUALITY" } }
      ]
    }
  ]
}
{% endschema %}