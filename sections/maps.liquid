{{ 'google-maps.css' | asset_url | stylesheet_tag }}
<script src="{{ 'maps.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign st = section.settings
  assign animation_effect = settings.animations
  assign animated = false
  if animation_effect != 'none'
    assign animated = true
    if section.settings.animations != 'inherit'
      assign animation_effect = section.settings.animations
    endif
  endif

  assign container = section.settings.container
  if container == 'w-full'
    assign container = 'container-full'
  endif
-%}

<style>
  /* Premium Map Section Custom Styles */
  #m-section--{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
  }

  .premium-map-wrapper {
    display: flex;
    flex-wrap: wrap;
    background: #ffffff;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.08);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  
  .premium-map-wrapper:hover {
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.12);
  }

  .premium-map-content {
    flex: 1 1 40%;
    padding: 60px 50px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: #ffffff;
    min-width: 300px;
  }

  .premium-map-media {
    flex: 1 1 60%;
    min-height: 450px;
    position: relative;
    min-width: 300px;
  }

  .premium-map-media iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100% !important;
    height: 100% !important;
    border: none;
  }

  /* Grayscale Effect for Premium Look */
  {% if section.settings.enable_grayscale %}
  .premium-map-media iframe {
    filter: grayscale(100%) contrast(1.1) opacity(0.9);
  }
  {% endif %}

  /* Typography Enhancements */
  .premium-map-content .m-section__subheading {
    color: #a0aec0;
    font-weight: 600;
    letter-spacing: 2px;
    margin-bottom: 15px;
    font-size: 12px;
  }

  .premium-map-content .m-section__heading {
    font-size: 2.5rem;
    font-weight: 700;
    color: #1a202c;
    margin-bottom: 25px;
    line-height: 1.2;
  }

  .premium-map-content .m-section__description {
    color: #4a5568;
    font-size: 16px;
    line-height: 1.8;
    margin-bottom: 35px;
  }

  .premium-map-content .m-button {
    align-self: flex-start;
    padding: 15px 35px;
    border-radius: 50px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.3s ease;
  }

  /* Reverse Layout */
  {% if section.settings.layout == 'map_left' %}
    .premium-map-wrapper {
      flex-direction: row-reverse;
    }
  {% endif %}

  @media (max-width: 768px) {
    .premium-map-content {
      padding: 40px 25px;
    }
    .premium-map-media {
      min-height: 350px;
    }
    .premium-map-content .m-section__heading {
      font-size: 2rem;
    }
  }
</style>

<section
  id="m-section--{{ section.id }}"
  data-section-type="google-maps"
  data-section-id="{{ section.id }}"
  class="m-section"
>
  <div class="{{ container }}">
    <div class="premium-map-wrapper{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}">
      
      <!-- Content Area -->
      <div class="premium-map-content">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'subheading' %}
              {% if block.settings.subheading != blank %}
                <p class="m-section__subheading m:uppercase">{{ block.settings.subheading }}</p>
              {% endif %}
              
            {% when 'heading' %}
              {% if block.settings.heading != blank %}
                <h2 class="m-section__heading {{ block.settings.heading_size }}">{{ block.settings.heading }}</h2>
              {% endif %}
              
            {% when 'text' %}
              {% if block.settings.text != blank %}
                <div class="m-section__description rte">
                  {{ block.settings.text }}
                </div>
              {% endif %}
              
            {% when 'button' %}
              {% if block.settings.button_label != blank %}
                <a
                  href="{{ block.settings.button_link }}"
                  class="m-button {{ block.settings.button_style | replace: 'sf__btn-primary', 'm-button--primary' | replace: 'sf__btn-secondary', 'm-button--secondary' | replace: 'sf__btn-link', 'm-button--link' | replace: 'sf__btn-white', 'm-button--white' }}"
                >
                  {{- block.settings.button_label -}}
                </a>
              {% endif %}
          {% endcase %}
        {% endfor %}
      </div>

      <!-- Map Area -->
      <div class="premium-map-media">
        {% if section.settings.iframe_code != blank %}
          {{ section.settings.iframe_code }}
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'm-placeholder-svg' }}
        {% endif %}
      </div>

    </div>
  </div>
</section>

