<a
  href="{{ routes.cart_url }}"
  class="m-cart-icon-bubble"
  aria-label="{{ cart.item_count }}"
  style="display: flex; align-items: center; position: relative; text-decoration: none;"
>
  
  <svg 
    xmlns="http://www.w3.org/2000/svg" 
    width="28" 
    height="28" 
    viewBox="0 0 24 24" 
    fill="none" 
    stroke="#ffffff" 
    stroke-width="1.5" 
    stroke-linecap="round" 
    stroke-linejoin="round"
    style="display: block;"
  >
    <!-- Bag body -->
    <rect x="4" y="9" width="16" height="12" rx="3" />
    <!-- Handle (overlaps into the bag) -->
    <path d="M8 13V7a4 4 0 0 1 8 0v6" />
  </svg>
  
  <m-cart-count class="m-cart-count-bubble m-cart-count{% if cart == empty %} m:hidden{% endif %} m:font-bold">
    {%- if cart.item_count < 100 -%}
      {{- cart.item_count -}}
    {%- else -%}
      99+
    {%- endif -%}
  </m-cart-count>
</a>