{%- liquid
  assign search_display = header_settings.search
  assign main_class = 'm-header__search custom-search-design'

  if icon_left == true
    assign main_class = main_class | append: ' m-search-form--icon-left'
  endif

  if search_display == 'show_full'
    assign main_class = main_class | append: ' m-search-form--full'
  endif

  if box_size != blank
    assign main_class = main_class | append: ' ' | append: box_size
  endif

  assign main_class = main_class | append: ' m:flex m:items-center'
-%}

{% unless search_display == 'hide' %}
  <m-search-popup class="{{ main_class }}" data-open-search-popup>
    {% if icon_left == true %}
      <button
        class="m-search-form__button m:flex m:items-center"
        aria-label="{{ 'general.search.placeholder_short' | t }}"
      >
        <span class="m-tooltip m:block m-tooltip--bottom m-tooltip--style-2">
          <svg
            class="m-svg-icon--medium-small"
            fill="currentColor"
            stroke="currentColor"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 512 512"
          >
            <path d="M508.5 468.9L387.1 347.5c-2.3-2.3-5.3-3.5-8.5-3.5h-13.2c31.5-36.5 50.6-84 50.6-136C416 93.1 322.9 0 208 0S0 93.1 0 208s93.1 208 208 208c52 0 99.5-19.1 136-50.6v13.2c0 3.2 1.3 6.2 3.5 8.5l121.4 121.4c4.7 4.7 12.3 4.7 17 0l22.6-22.6c4.7-4.7 4.7-12.3 0-17zM208 368c-88.4 0-160-71.6-160-160S119.6 48 208 48s160 71.6 160 160-71.6 160-160 160z"/>
          </svg>
          <span class="m-tooltip__content">{{ 'general.search.placeholder_short' | t }}</span>
        </span>
      </button>
    {% endif %}
    
    {%- if search_display == 'show_full' -%}
      <span class="m-search-form__label typing-wrapper">
        <span class="static-search-text">Try searching for...&nbsp;</span>
        <span class="animated-search-text"></span><span class="typing-cursor"> </span>
      </span>
    {%- endif -%}
    
    {% if icon_left == blank or icon_left == false %}
      <button type="submit" class="m-search-form__button" aria-label="{{ 'general.search.placeholder_short' | t }}">
        <span class="m-tooltip m:block m-tooltip--bottom m-tooltip--style-2">
          <svg
            class="m-svg-icon--medium-small"
            fill="currentColor"
            stroke="currentColor"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 512 512"
          >
            <path d="M508.5 468.9L387.1 347.5c-2.3-2.3-5.3-3.5-8.5-3.5h-13.2c31.5-36.5 50.6-84 50.6-136C416 93.1 322.9 0 208 0S0 93.1 0 208s93.1 208 208 208c52 0 99.5-19.1 136-50.6v13.2c0 3.2 1.3 6.2 3.5 8.5l121.4 121.4c4.7 4.7 12.3 4.7 17 0l22.6-22.6c4.7-4.7 4.7-12.3 0-17zM208 368c-88.4 0-160-71.6-160-160S119.6 48 208 48s160 71.6 160 160-71.6 160-160 160z"/>
          </svg>
          <span class="m-tooltip__content">{{ 'general.search.placeholder_short' | t }}</span>
        </span>
      </button>
    {% endif %}
  </m-search-popup>
{% endunless %}

<style>
  /* 
    Overrides default theme box styles to match the underline reference
  */
  .custom-search-design {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    
    /* Strict border overrides */
    border: none !important; 
    {% comment %} border-bottom: 1.5px solid currentColor !important;  {% endcomment %}
    border-radius: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
    
    /* Adjust padding to only be at the bottom */
    padding: 0 0 0 0 !important; 
    width: 100%;
  }


  .typing-wrapper {
    display: flex !important;
    align-items: center !important;
    justify-content: flex-start !important; 
    text-align: left !important;
    flex-grow: 1 !important; 
    width: 100% !important;
    margin-right: auto !important;
    white-space: nowrap;
    overflow: hidden;
  }

  .static-search-text {
    flex-shrink: 0; 
  }

  .animated-search-text {
    font-weight: 500;
    white-space: pre;
  }
  
  .typing-cursor {
    display: inline-block;
    width: 2px;
    margin-left: 2px;
    background-color: currentColor; 
    animation: blinkCursor 0.75s step-end infinite;
  }
  
  .m-search-form__button {
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
    cursor: pointer;
    display: flex;
    align-items: center;
  }

  @keyframes blinkCursor {
    from, to { opacity: 1; }
    50% { opacity: 0; }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const words = ["T-shirt", "Cap", "Accessories", "Sleeve"];
    let i = 0;
    let timer;
    const typingSpeed = 100;
    const deletingSpeed = 50;
    const delayBetweenWords = 2000;
    
    const animatedElement = document.querySelector('.animated-search-text');
    
    if(animatedElement) {
      function typingEffect() {
        let word = words[i].split("");
        let loopTyping = function() {
          if (word.length > 0) {
            animatedElement.innerHTML += word.shift();
          } else {
            setTimeout(deletingEffect, delayBetweenWords);
            return false;
          }
          timer = setTimeout(loopTyping, typingSpeed);
        };
        loopTyping();
      }

      function deletingEffect() {
        let word = words[i].split("");
        let loopDeleting = function() {
          if (word.length > 0) {
            word.pop();
            animatedElement.innerHTML = word.join("");
          } else {
            if (words.length > (i + 1)) {
              i++;
            } else {
              i = 0; 
            }
            setTimeout(typingEffect, 500); 
            return false;
          }
          timer = setTimeout(loopDeleting, deletingSpeed);
        };
        loopDeleting();
      }

      typingEffect();
    }
  });
</script>